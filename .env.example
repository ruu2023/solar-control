# MAC address of your Renogy BT-1/BT-2 module. Find it with:
#   python -m solar_control scan
RENOGY_MAC_ADDRESS=

# Modbus device id. 255 works for a single controller wired directly to
# the BT module. Only change this for daisy-chained/hub setups.
RENOGY_DEVICE_ID=255

# C or F
RENOGY_TEMP_UNIT=C

API_HOST=0.0.0.0
API_PORT=8000

# EcoFlow DELTA 2 (home battery) via official REST API. Optional: if left
# blank, `status` / `/status` still work and just report an "not configured"
# error for the home_battery section.
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
ECOFLOW_DEVICE_SN=
ECOFLOW_BASE_URL=https://api-e.ecoflow.com
